# Salin file ini menjadi .env lalu sesuaikan nilainya
# Jangan pernah commit file .env (berisi kredensial) ke git

PORT=3000

# Isi "production" saat sudah online (mengaktifkan cookie secure untuk HTTPS)
NODE_ENV=development

# Ganti dengan string acak yang panjang & rahasia (dipakai untuk enkripsi session)
SESSION_SECRET=string-acak-panjang-dan-rahasia-untuk-enkripsi-session
# ---------- Supabase ----------
# Connection string Postgres: Supabase Dashboard > Connect > Connection string.
# Pakai "Session pooler" (atau Transaction pooler) — bukan "Direct connection",
# karena direct connection hanya IPv6 dan sering gagal di hosting gratis.
# Ganti [YOUR-PASSWORD] dengan password database yang kamu buat saat membuat project.
DATABASE_URL=postgresql://postgres.abcdefghijklmn.supabase.co:5432/postgres?sslmode=require&password=[YOUR-PASSWORD]

# URL project + service_role key: Dashboard > Project Settings > API (atau API Keys).
# ⚠️ service_role key = RAHASIA. Hanya untuk server ini; jangan taruh di frontend atau git.
SUPABASE_URL=https://abcdefghijklmn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ.......

SUPABASE_BUCKET=product-images

# ---------- Admin ----------
# Kredensial admin tunggal (single user), hanya dipakai untuk membuat akun admin PERTAMA KALI
# saat tabel users masih kosong. Default di bawah: username "admin", password "noona123".
# GANTI SEGERA, buat hash baru dengan:
#   node scripts/hash-password.js password-baru-kamu
# lalu salin hasilnya ke ADMIN_PASSWORD_HASH di bawah (sebelum server dijalankan pertama kali).
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=isi dengan hash password baru yang dibuat

# Nomor WhatsApp toko yang menerima pesan konfirmasi pesanan, booking layanan,
# dan kontak langsung dari tombol WhatsApp mengambang di pojok kanan bawah.
# Format: kode negara tanpa "+" atau "0" di depan.
WA_NUMBER=628156587891

# Salin file ini menjadi .env lalu sesuaikan nilainya
# Jangan pernah commit file .env (berisi kredensial) ke git

PORT=3000

# Ganti dengan string acak yang panjang & rahasia (dipakai untuk enkripsi session)
SESSION_SECRET=ganti-dengan-string-acak-yang-sangat-panjang-dan-rahasia

# Kredensial admin tunggal (single user)
# Default di bawah ini untuk username "admin" dan password "noona123"
# GANTI SEGERA setelah pertama kali menjalankan aplikasi:
#   node scripts/hash-password.js password-baru-kamu
# lalu salin hasilnya ke ADMIN_PASSWORD_HASH di bawah
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2a$10$3wu3rF27iZIg4oD14p6jfOMeby0QQ2KFtTAe9ZLpa7jSdzApsExLy

# Nomor WhatsApp toko yang menerima pesan konfirmasi pesanan, booking layanan,
# dan kontak langsung dari tombol WhatsApp mengambang di pojok kanan bawah.
# Format: kode negara tanpa "+" atau "0" di depan.
WA_NUMBER=628156587891
